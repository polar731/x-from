<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.polar.x.infrastructure.dao.IFormSubmissionDao">

    <resultMap id="SubmissionMap" type="cn.polar.x.infrastructure.dao.po.FormSubmissionPO">
        <id column="id" property="id"/>
        <result column="form_id" property="formId"/>
        <result column="form_no" property="formNo"/>
        <result column="data_json" property="dataJson"/>
        <result column="submit_ip" property="submitIp"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, form_id, form_no, data_json, submit_ip, create_time
    </sql>

    <insert id="insert" parameterType="cn.polar.x.infrastructure.dao.po.FormSubmissionPO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO form_submission (form_id, form_no, data_json, submit_ip, create_time)
        VALUES (#{formId}, #{formNo}, #{dataJson}, #{submitIp}, NOW())
    </insert>

    <select id="queryListByFormNo" resultMap="SubmissionMap">
        SELECT <include refid="Base_Column_List"/>
        FROM form_submission
        WHERE form_no = #{formNo}
        ORDER BY id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByFormNo" resultType="int">
        SELECT COUNT(1)
        FROM form_submission
        WHERE form_no = #{formNo}
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(1) FROM form_submission
    </select>

</mapper>
